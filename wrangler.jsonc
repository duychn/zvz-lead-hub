{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zvz-lead-hub",
  "main": "src/index.ts",
  "account_id": "b451aa34f369ca1461c9b90d7fe2ecd8",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "routes": [{ "pattern": "demo.zvzdigital.com", "custom_domain": true }],
  "kv_namespaces": [
    { "binding": "LEADS", "id": "a49ea6f2b5fb4c1ab56a75837145c030" }
  ],
  // The public demo endpoint is limited per IP so it cannot be used to burn API credits.
  "ratelimits": [
    { "name": "DEMO_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ]
  // Secrets (set with `wrangler secret put <NAME>`, never committed):
  // INTAKE_TOKEN, ANTHROPIC_API_KEY, HUBSPOT_TOKEN, N8N_WEBHOOK_URL,
  // META_VERIFY_TOKEN, META_APP_SECRET, META_PAGE_TOKEN
}
